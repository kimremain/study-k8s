{
  "name": "kubewatch",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kubewatch",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@kubewatch/api",
      "version": "0.0.0"
    },
    "apps/scheduler": {
      "name": "@kubewatch/scheduler",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@kubewatch/web",
      "version": "0.0.0"
    },
    "apps/worker": {
      "name": "@kubewatch/worker",
      "version": "0.0.0"
    },
    "node_modules/@kubewatch/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@kubewatch/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@kubewatch/scheduler": {
      "resolved": "apps/scheduler",
      "link": true
    },
    "node_modules/@kubewatch/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@kubewatch/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/contracts": {
      "name": "@kubewatch/contracts",
      "version": "0.0.0"
    }
  }
}
